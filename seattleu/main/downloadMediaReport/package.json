{
  "name": "downloadfrommedialibrary",
  "version": "1.0.1",
  "description": "SeattleU Media Downloader",
  "main": "dist/bundle.js",
  "bin": "dist/bundle.js",
  "type": "module",
  "scripts": {
    "clean": "rmdir /s /q dist",
    "build": "esbuild index.mjs --bundle --platform=node --format=cjs --outfile=dist/bundle.js",
    "package": "pkg dist/bundle.js --targets node16-win-x64 --output dist/media-downloader.exe"
  },
  "author": "Prasanth Gururaj",
  "license": "ISC",
  "dependencies": {
    "exceljs": "^4.4.0",
    "node-fetch": "^2.7.0",
    "t4.ts": "^0.0.11",
    "tslib": "^2.8.1",
    "zip-a-folder": "^3.1.6"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "pkg": "^5.8.1"
  }
}
